{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softboys-club",
  "compatibility_date": "2026-10-01",
  // served from our own domain, no workers.dev address
  "workers_dev": false,
  "routes": [
    { "pattern": "softboys.club", "custom_domain": true },
    { "pattern": "www.softboys.club", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
